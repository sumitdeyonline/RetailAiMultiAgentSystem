# Step 1: Build the React Application
FROM node:20-slim AS builder

# Set working directory
WORKDIR /app

# Copy package configuration and install dependencies
COPY frontend/package*.json ./
RUN npm install

# Copy all frontend files
COPY frontend/ .

# Accept the API URL from Cloud Build and expose it to Vite
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

# Build the React app
RUN npm run build

# Step 2: Serve using NGINX
FROM nginx:alpine

# Copy built assets to NGINX HTML folder
COPY --from=builder /app/dist /usr/share/nginx/html

# Provide a simple custom Nginx config to handle React router if necessary
RUN echo "server { listen 8080; location / { root /usr/share/nginx/html; index index.html index.htm; try_files \$uri \$uri/ /index.html; } }" > /etc/nginx/conf.d/default.conf

# Cloud Run expects the container to listen on the port defined by the PORT env variable (default is 8080)
EXPOSE 8080

# Start NGINX
CMD ["nginx", "-g", "daemon off;"]
