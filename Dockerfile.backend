# Use official Python lightweight image
FROM python:3.12-slim

# Install system dependencies (e.g. required for building psycopg if necessary)
RUN apt-get update && apt-get install -y libpq-dev gcc && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Install the ultra-fast 'uv' package manager
RUN pip install uv

# Copy application files
COPY . .

# Install Python dependencies natively
RUN uv sync

# Cloud Run injects the PORT environment variable (default 8080)
ENV PORT=8080
EXPOSE 8080

# Add virtual environment to PATH so python and uvicorn are globally available
ENV PATH="/app/.venv/bin:$PATH"

# Start FastAPI server explicitly using the python binary from the virtual environment
CMD ["/app/.venv/bin/python", "-m", "uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8080"]
